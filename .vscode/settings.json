{
  // TypeScript language features run on tsrs, the repository's pinned compiler, through the tsdk its package ships.
  // Lint is the oxc extension: node_modules' oxlint with oxlint.config.ts, and its type-aware rules run on the pinned
  // tsrs-lint that `bun tools/tsrs-lint.ts` caches (the tag below equals the pin in tools/tsrs-lint.ts). Effect
  // diagnostics come from `bun run typecheck`.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/tsrs/tsdk",
  "oxc.enable.oxlint": true,
  "oxc.path.tsgolint": "${userHome}/.cache/tsrs-lint/lint-pr624-0acc433-regions.1/tsrs-lint"
}
