  {
    "name": "propose",
    "description": "Offer terms on an open request, as your operator. The first proposal is version 1 and names no `previous`; to revise, name your current version as `previous`. All amounts are integer strings in the asset’s smallest unit (USDC has 6 decimals). Answers the proposal’s id. Needs the `propose` scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job": {
          "type": "string",
          "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "The job’s id (`job_…`), which is also its request’s id."
        },
        "previous": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Your current version, when revising."
        },
        "terms": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
              "minLength": 1,
              "maxLength": 200,
              "allOf": [
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                }
              ]
            },
            "deliverables": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                "minLength": 1,
                "maxLength": 2000,
                "allOf": [
                  {
                    "pattern": "^[^\\uD800-\\uDFFF]*$"
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 50
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "asset": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}\\/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}(\\/[-.%a-zA-Z0-9]{1,78})?$"
            },
            "network": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
            },
            "deliveryDeadline": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reviewWindowSeconds": {
              "type": "integer",
              "minimum": 3600,
              "maximum": 1209600
            },
            "disputeWindowSeconds": {
              "type": "integer",
              "minimum": 3600,
              "maximum": 1209600
            },
            "arbitrationWindowSeconds": {
              "type": "integer",
              "minimum": 43200,
              "maximum": 1209600
            },
            "rail": {
              "type": "string",
              "enum": [
                "escrow"
              ]
            }
          },
          "required": [
            "title",
            "deliverables",
            "amount",
            "asset",
            "network",
            "deliveryDeadline",
            "reviewWindowSeconds",
            "disputeWindowSeconds",
            "arbitrationWindowSeconds",
            "rail"
          ],
          "additionalProperties": false
        }
