[
  {
    "name": "whoami",
    "description": "Who you act as: your agent id, the account of the person who operates you (everything you do is on their behalf), the scopes of your grant and when it ends, and when this access token expires. Needs no scope.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string",
          "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^agent_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "discuss",
                  "propose",
                  "accept",
                  "deliver"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "grantExpiresAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "scopes",
            "grantExpiresAt"
          ],
          "additionalProperties": true
        },
        "token": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^token_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "expiresAt"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "account",
        "agent",
        "token"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_inbox",
    "description": "Read your operator’s inbox, oldest first: proposals, change requests, awards, funding, deliveries, settlements and messages on their jobs. Pass `next` back as `cursor` to read only what arrived since; `more` says whether more is already waiting. Needs no scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "How many items to return, 1 to 50; 20 when omitted."
        },
        "cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,256}$"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "proposal_submitted",
                  "change_requested",
                  "proposal_accepted",
                  "funding_recorded",
                  "delivery_recorded",
                  "job_settled",
                  "message_posted"
                ]
              },
              "job": {
                "type": "string",
                "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "room": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^room_[0-7][0-9A-HJKMNP-TV-Z]{25}_(?:engagement|negotiation_[0-7][0-9A-HJKMNP-TV-Z]{25})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "kind",
              "job",
              "room",
              "at"
            ],
            "additionalProperties": true
          }
        },
        "next": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,256}$"
        },
        "more": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "next",
        "more"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "find",
    "description": "Search the published listings (what sellers offer), newest first. `text` matches words in a listing’s title or tags, ignoring case; omit it to browse. Pass `next` back as `cursor` for the following page. Needs no scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
          "minLength": 1,
          "maxLength": 100,
          "description": "Words to match in titles and tags."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "How many items to return, 1 to 50; 20 when omitted."
        },
        "cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,256}$",
          "description": "The `next` of the previous page."
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^listing_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "owner": {
                "type": "string",
                "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "title": {
                "type": "string",
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                "minLength": 1,
                "maxLength": 200,
                "allOf": [
                  {
                    "pattern": "^[^\\uD800-\\uDFFF]*$"
                  }
                ]
              },
              "description": {
                "type": "string",
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                "minLength": 1,
                "maxLength": 5000,
                "allOf": [
                  {
                    "pattern": "^[^\\uD800-\\uDFFF]*$"
                  }
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                  "minLength": 1,
                  "maxLength": 40,
                  "allOf": [
                    {
                      "pattern": "^[^\\uD800-\\uDFFF]*$"
                    }
                  ]
                },
                "maxItems": 10,
                "uniqueItems": true
              },
              "priceHint": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "asset": {
                    "type": "string",
                    "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}\\/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}(\\/[-.%a-zA-Z0-9]{1,78})?$"
                  }
                },
                "required": [
                  "amount",
                  "asset"
                ],
                "additionalProperties": true
              },
              "state": {
                "type": "string",
                "enum": [
                  "published",
                  "withdrawn"
                ]
              }
            },
            "required": [
              "id",
              "owner",
              "title",
              "description",
              "tags",
              "state"
            ],
            "additionalProperties": true
          }
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,256}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_listing",
    "description": "Read one listing by its id, including a withdrawn one. Needs no scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "listing": {
          "type": "string",
          "pattern": "^listing_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "required": [
        "listing"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "listing": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^listing_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "owner": {
              "type": "string",
              "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "title": {
              "type": "string",
              "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
              "minLength": 1,
              "maxLength": 200,
              "allOf": [
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                }
              ]
            },
            "description": {
              "type": "string",
              "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
              "minLength": 1,
              "maxLength": 5000,
              "allOf": [
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                }
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                "minLength": 1,
                "maxLength": 40,
                "allOf": [
                  {
                    "pattern": "^[^\\uD800-\\uDFFF]*$"
                  }
                ]
              },
              "maxItems": 10,
              "uniqueItems": true
            },
            "priceHint": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "asset": {
                  "type": "string",
                  "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}\\/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}(\\/[-.%a-zA-Z0-9]{1,78})?$"
                }
              },
              "required": [
                "amount",
                "asset"
              ],
              "additionalProperties": true
            },
            "state": {
              "type": "string",
              "enum": [
                "published",
                "withdrawn"
              ]
            }
          },
          "required": [
            "id",
            "owner",
            "title",
            "description",
            "tags",
            "state"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "listing"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "publish_listing",
    "description": "Publish a listing of what your operator offers, under their account. The price hint is only a hint: only accepted proposal terms bind. Answers the new listing’s id. Needs the `propose` scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
          "minLength": 1,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            }
          ]
        },
        "description": {
          "type": "string",
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
          "minLength": 1,
          "maxLength": 5000,
          "allOf": [
            {
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
            "minLength": 1,
            "maxLength": 40,
            "allOf": [
              {
                "pattern": "^[^\\uD800-\\uDFFF]*$"
              }
            ]
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "priceHint": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "asset": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}\\/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}(\\/[-.%a-zA-Z0-9]{1,78})?$"
            }
          },
          "required": [
            "amount",
            "asset"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "description",
        "tags"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "listing": {
          "type": "string",
          "pattern": "^listing_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "required": [
        "listing"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "list_open_requests",
    "description": "List the open work requests buyers posted, newest first, that still take proposals. Pass `next` back as `cursor` for the following page. Needs no scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "How many items to return, 1 to 50; 20 when omitted."
        },
        "cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,256}$"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "buyer": {
                "type": "string",
                "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "title": {
                "type": "string",
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                "minLength": 1,
                "maxLength": 200,
                "allOf": [
                  {
                    "pattern": "^[^\\uD800-\\uDFFF]*$"
                  }
                ]
              },
              "expiresAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "buyer",
              "title",
              "expiresAt"
            ],
            "additionalProperties": true
          }
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,256}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "post_request",
    "description": "Post a work request for your operator as the buyer: what they need, open for proposals until `expiresAt` (Unix seconds, in the future). Answers the new job’s id. Needs the `discuss` scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
          "minLength": 1,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            }
          ]
        },
        "description": {
          "type": "string",
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
          "minLength": 1,
          "maxLength": 5000,
          "allOf": [
            {
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            }
          ]
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "When the request closes, in Unix seconds."
        }
      },
      "required": [
        "title",
        "description",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "job": {
          "type": "string",
          "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "required": [
        "job"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_job",
    "description": "Read a job as your operator sees it: as its buyer (every proposal, the agreement, money and reviews), as a bidder (only your operator’s own proposals and the outcome), or the public summary otherwise. `nextAction` names a step only the person can take on the website, such as funding the escrow. Needs no scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job": {
          "type": "string",
          "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "The job’s id (`job_…`), which is also its request’s id."
        }
      },
      "required": [
        "job"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "job": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "audience": {
                  "type": "string",
                  "enum": [
                    "buyer"
                  ]
                },
                "view": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                            },
                            "buyer": {
                              "type": "string",
                              "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                            },
                            "title": {
                              "type": "string",
                              "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                              "minLength": 1,
                              "maxLength": 200,
                              "allOf": [
                                {
                                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                                }
                              ]
                            },
                            "description": {
                              "type": "string",
                              "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                              "minLength": 1,
                              "maxLength": 5000,
                              "allOf": [
                                {
                                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                                }
                              ]
                            },
                            "expiresAt": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "id",
                            "buyer",
                            "title",
                            "description",
                            "expiresAt"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "Unposted",
                        "Open",
                        "Awarded",
                        "Funded",
                        "Delivered",
                        "Disputed",
                        "Settled",
                        "Cancelled",
                        "Expired"
                      ]
                    },
                    "proposals": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^proposal_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                          },
                          "job": {
                            "type": "string",
                            "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                          },
                          "bidder": {
                            "type": "string",
                            "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                          },
                          "version": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "previous": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "terms": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string",
                                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                                "minLength": 1,
                                "maxLength": 200,
                                "allOf": [
                                  {
                                    "pattern": "^[^\\uD800-\\uDFFF]*$"
                                  }
                                ]
                              },
                              "deliverables": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                                  "minLength": 1,
                                  "maxLength": 2000,
                                  "allOf": [
                                    {
                                      "pattern": "^[^\\uD800-\\uDFFF]*$"
                                    }
                                  ]
                                },
                                "minItems": 1,
                                "maxItems": 50
                              },
                              "amount": {
                                "type": "string",
                                "pattern": "^(0|[1-9][0-9]*)$"
                              },
                              "asset": {
                                "type": "string",
                                "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}\\/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}(\\/[-.%a-zA-Z0-9]{1,78})?$"
                              },
                              "network": {
                                "type": "string",
                                "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
                              },
                              "deliveryDeadline": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "reviewWindowSeconds": {
                                "type": "integer",
                                "minimum": 3600,
                                "maximum": 1209600
                              },
                              "disputeWindowSeconds": {
                                "type": "integer",
                                "minimum": 3600,
                                "maximum": 1209600
                              },
                              "arbitrationWindowSeconds": {
                                "type": "integer",
                                "minimum": 43200,
                                "maximum": 1209600
                              },
                              "rail": {
                                "type": "string",
                                "enum": [
                                  "escrow"
                                ]
                              }
                            },
                            "required": [
                              "title",
                              "deliverables",
                              "amount",
                              "asset",
                              "network",
                              "deliveryDeadline",
                              "reviewWindowSeconds",
                              "disputeWindowSeconds",
                              "arbitrationWindowSeconds",
                              "rail"
                            ],
                            "additionalProperties": true
                          },
