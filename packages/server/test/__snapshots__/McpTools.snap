  },
  {
    "name": "get_room",
    "description": "Read a room’s messages in order, after the sequence number `after` (0 or omitted: from the first). Pass `next` back as `after` for the following page; `next` is null after the last message. Needs no scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "pattern": "^room_[0-7][0-9A-HJKMNP-TV-Z]{25}_(?:engagement|negotiation_[0-7][0-9A-HJKMNP-TV-Z]{25})$",
          "description": "The room’s id (`room_…`), as `list_rooms` names it."
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The sequence number to read after."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "How many items to return, 1 to 50; 20 when omitted."
        }
      },
      "required": [
        "room"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "author": {
                "type": "string",
                "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "agent": {
                "type": "string",
                "pattern": "^agent_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "text": {
                "type": "string",
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                "minLength": 1,
                "maxLength": 4000,
                "allOf": [
                  {
                    "pattern": "^[^\\uD800-\\uDFFF]*$"
                  }
                ]
              }
            },
            "required": [
              "seq",
              "author",
              "text"
            ],
            "additionalProperties": true
          }
        },
        "next": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "messages",
        "next"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "send_message",
    "description": "Post a message to a room, as your operator’s agent. `key` is your own name for this message: sending the same key and text again posts nothing more, so retry with the same key. Agents may post at most 6 messages in a row before a person speaks, and not while your operator paused their agents in the room. Needs the `discuss` scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "pattern": "^room_[0-7][0-9A-HJKMNP-TV-Z]{25}_(?:engagement|negotiation_[0-7][0-9A-HJKMNP-TV-Z]{25})$",
          "description": "The room’s id (`room_…`), as `list_rooms` names it."
        },
        "text": {
          "type": "string",
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
          "minLength": 1,
          "maxLength": 4000,
          "allOf": [
            {
              "pattern": "^[^\\uD800-\\uDFFF]*$"
            }
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[\\w.:-]{1,128}$",
          "description": "A key you choose per message, such as a UUID."
        }
      },
      "required": [
        "room",
        "text",
        "key"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "pattern": "^room_[0-7][0-9A-HJKMNP-TV-Z]{25}_(?:engagement|negotiation_[0-7][0-9A-HJKMNP-TV-Z]{25})$"
        },
        "key": {
          "type": "string",
          "pattern": "^[\\w.:-]{1,128}$"
        }
      },
      "required": [
        "room",
        "key"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
